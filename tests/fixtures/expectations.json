[
  {
    "name": "missing-frontmatter",
    "lint_must_fail": true,
    "evals_must_fail": true,
    "lint_contains": ["name is required", "description is required"],
    "evals_contains": ["Missing or malformed YAML frontmatter"]
  },
  {
    "name": "missing-name",
    "lint_must_fail": true,
    "evals_must_fail": true,
    "lint_contains": ["name is required"],
    "evals_contains": ["Frontmatter missing required field: 'name'"]
  },
  {
    "name": "description-too-long",
    "lint_must_fail": true,
    "evals_must_fail": true,
    "lint_contains": ["description exceeds 1024 characters"],
    "evals_contains": ["exceeds the 1024-char limit"]
  },
  {
    "name": "broken-link",
    "lint_must_fail": true,
    "evals_must_fail": false,
    "lint_contains": ["(HTTP 404)"],
    "evals_contains": ["PASSED"]
  },
  {
    "name": "missing-referenced-file",
    "lint_must_fail": true,
    "evals_must_fail": false,
    "lint_contains": ["broken internal link: notes/missing.md (file not found)"],
    "evals_contains": ["PASSED"]
  },
  {
    "name": "good-skill",
    "tools": ["lint", "evals", "security"],
    "lint_must_fail": false,
    "evals_must_fail": false,
    "security_must_fail": false,
    "lint_contains": ["Result: passed"],
    "evals_contains": ["PASSED"],
    "security_contains": ["PASS: security checks passed"]
  },
  {
    "name": "injection-hidden-text",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": ["hidden Unicode U+200B", "hidden Unicode U+202E"]
  },
  {
    "name": "injection-override",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": ["instruction override phrase: ignore previous instructions"]
  },
  {
    "name": "injection-exfil",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": [
      "sends file or environment contents to a URL",
      "reads .env, a private key, or ~/.ssh",
      "Exfiltration: curl or wget sends a file or the environment to a URL"
    ]
  },
  {
    "name": "license-bad",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": [
      "not an SPDX license identifier",
      "strong copyleft",
      "non-commercial",
      "unknown license"
    ]
  },
  {
    "name": "safe-rm",
    "tools": ["security"],
    "security_must_fail": false,
    "security_contains": ["PASS: security checks passed"]
  },
  {
    "name": "secret-in-script",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": ["gitleaks generic-api-key"]
  },
  {
    "name": "dangerous-command",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": [
      "Dangerous command: curl output piped to a shell",
      "Dangerous command: eval",
      "Dangerous command: rm -rf of a root, home, or variable path",
      "Dangerous command: base64-decoded output is executed"
    ]
  },
  {
    "name": "undeclared-binary",
    "tools": ["security"],
    "security_must_fail": true,
    "security_contains": ["undeclared binary payload.bin"]
